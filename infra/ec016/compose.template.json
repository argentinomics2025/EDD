{
  "services": {
    "ec016-db": {
      "environment": {
        "POSTGRES_USER": "ec016_admin",
        "POSTGRES_PASSWORD": "EC016_SYNTHETIC_ADMIN_ONLY",
        "POSTGRES_DB": "ec016_disposable",
        "POSTGRES_INITDB_ARGS": "--encoding=UTF8 --locale=C.UTF-8"
      },
      "tmpfs": [
        "/var/lib/postgresql/data"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "./schema.sql",
          "target": "/opt/ec016/schema.sql",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./db-entrypoint.sh",
          "target": "/opt/ec016/db-entrypoint.sh",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./bootstrap.sh",
          "target": "/docker-entrypoint-initdb.d/001-ec016.sh",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "networks": {
        "isolated": {
          "ipv4_address": "172.30.216.2"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U ec016_admin -d ec016_disposable"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 30
      },
      "mem_limit": "768m",
      "platform": "linux/amd64",
      "entrypoint": [
        "bash",
        "/opt/ec016/db-entrypoint.sh"
      ]
    },
    "ec016-api": {
      "environment": {
        "PGRST_DB_URI": "postgres://ec016_authenticator:EC016_SYNTHETIC_AUTH_ONLY@ec016-db:5432/ec016_disposable",
        "PGRST_DB_SCHEMAS": "api",
        "PGRST_DB_ANON_ROLE": "ec016_reader",
        "PGRST_JWT_SECRET": "EC016_PUBLIC_SYNTHETIC_JWT_KEY_NOT_A_REAL_SECRET_0123456789",
        "PGRST_SERVER_PORT": "3000"
      },
      "depends_on": {
        "ec016-db": {
          "condition": "service_healthy"
        }
      },
      "networks": {
        "isolated": {
          "ipv4_address": "172.30.216.3"
        }
      },
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "256m",
      "platform": "linux/amd64",
      "volumes": []
    },
    "ec016-tests": {
      "environment": {
        "EC016_EXECUTE_DISPOSABLE": "YES_SYNTHETIC_ONLY",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "depends_on": [
        "ec016-api"
      ],
      "networks": {
        "isolated": {
          "ipv4_address": "172.30.216.4"
        }
      },
      "read_only": true,
      "tmpfs": [
        "/tmp"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "512m",
      "platform": "linux/amd64",
      "volumes": [],
      "user": "10001:10001"
    }
  },
  "networks": {
    "isolated": {
      "internal": true,
      "ipam": {
        "config": [
          {
            "subnet": "172.30.216.0/24",
            "gateway": "172.30.216.1"
          }
        ],
        "driver": "default"
      },
      "driver": "bridge"
    }
  }
}